# Observed primary configuration — PostgreSQL 18, 4 GiB RAM VM
# Lab example only: tune memory, networking, WAL limits, logging for real workloads.
# Applied by adding "include_dir = 'conf.d'" to postgresql.conf and storing this
# file at /u01/18/data/conf.d/10-native-ha.conf.

listen_addresses = '*'
port = 5432
password_encryption = 'scram-sha-256'

wal_level = replica
max_wal_senders = 10
max_replication_slots = 10
wal_keep_size = '256MB'
max_slot_wal_keep_size = '1GB'
hot_standby = on
fsync = on
full_page_writes = on
synchronous_commit = on
# No synchronous_standby_names: current replication is asynchronous.

shared_buffers = '1GB'
effective_cache_size = '2GB'
work_mem = '8MB'
maintenance_work_mem = '256MB'

logging_collector = on
log_destination = 'stderr'
log_directory = '/u01/18/log'
log_filename = 'postgresql-%Y-%m-%d_%H%M%S.log'
log_file_mode = 0600
log_rotation_age = '1d'
log_rotation_size = '100MB'
log_line_prefix = '%m [%p] user=%u db=%d client=%r app=%a sqlstate=%e '
log_timezone = 'UTC'
log_min_duration_statement = '1000ms'
log_lock_waits = on
log_temp_files = '64MB'
log_autovacuum_min_duration = '5s'
log_checkpoints = on
log_connections = 'authentication,authorization'
log_disconnections = off
log_statement = 'none'

shared_preload_libraries = 'pg_stat_statements'
compute_query_id = auto
track_io_timing = on
